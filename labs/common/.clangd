# labs/common sources (e.g. lab_sound_pad.c) need ESP-IDF FreeRTOS includes.
# Prefer a built step's compile_commands (has freertos/ + full IDF flags).
# Fallback Add: paths for headers opened alone without that database.
CompileFlags:
  CompilationDatabase: ../00-hello-device/step-02-sound-pad/build
  Remove:
    - -m*
    - -f*
    - -specs=*
  Add:
    - -xc
    - -std=c11
    - -D__XTENSA__
    - -isystem
    - C:/Espressif/tools/xtensa-esp-elf/esp-15.2.0_20251204/xtensa-esp-elf/lib/gcc/xtensa-esp-elf/15.2.0/include
    - -isystem
    - C:/Espressif/tools/xtensa-esp-elf/esp-15.2.0_20251204/xtensa-esp-elf/picolibc/include
    - -I
    - .
    - -I
    - ../../include/firmware-esp32-s3-dev
    - -I
    - ../../include/firmware-esp32-s3-dev/ui
    - -I
    - ../../include/firmware-esp32-s3-dev/middleware
    - -I
    - ../../ports
    - -I
    - ../../ports/boards/ws28p
  BuiltinHeaders: QueryDriver

Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
